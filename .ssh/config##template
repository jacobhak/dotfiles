Host github.com
  HostName github.com
  User git
  AddKeysToAgent yes
{% if yadm.os == "Darwin" %}
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
{% else %}
  IdentityFile ~/.ssh/id_ed25519_github
  IdentitiesOnly yes
{% endif %}

Host mac
  HostName 192.168.1.54
  User jacobhakansson
  ForwardAgent yes
  ServerAliveInterval 30
  ServerAliveCountMax 3

Host dev-vm
  HostName 192.168.1.43
  User jacob
  ForwardAgent yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
