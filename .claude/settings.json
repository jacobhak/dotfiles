{
  "env": {
    "API_FORCE_IDLE_TIMEOUT": "1"
  },
  "permissions": {
    "allow": [
      "mcp__bobbens-bots__read_messages",
      "mcp__bobbens-bots__send_message"
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "slack@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "tui": "fullscreen",
  "theme": "dark",
  "model": "opus[1m]"
}
