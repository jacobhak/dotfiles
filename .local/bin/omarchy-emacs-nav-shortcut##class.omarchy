#!/usr/bin/env bash
set -euo pipefail

action="${1:-}"

case "$action" in
    end-of-line | beginning-of-line | kill-line | backward-word | forward-word | backward-kill-word) ;;
    *)
        echo "Usage: ${0##*/} end-of-line|beginning-of-line|kill-line|backward-word|forward-word|backward-kill-word" >&2
        exit 2
        ;;
esac

active_class() {
    if command -v jq >/dev/null 2>&1; then
        local class
        class="$(hyprctl activewindow -j 2>/dev/null | jq -r '.class // ""' 2>/dev/null || true)"
        if [ -n "$class" ]; then
            printf '%s\n' "$class"
            return
        fi
    fi

    hyprctl activewindow 2>/dev/null | awk -F: '/^[[:space:]]*class:/ {
        sub(/^[[:space:]]*/, "", $2)
        print $2
        exit
    }'
}

# Terminals (readline/vim/tmux) and Emacs already implement these as native
# Emacs/readline bindings - pass the original chord straight through instead
# of translating it, so we don't double up or misfire inside e.g. tmux.
has_native_bindings() {
    case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
        alacritty | foot | kitty | com.mitchellh.ghostty | org.wezfurlong.wezterm | emacs)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

# Hyprland 0.56+ parses `hyprctl dispatch <text>` as the Lua expression
# `hl.dispatch(<text>)` rather than the old comma-separated dispatcher
# syntax, so this must build a real hl.dsp.send_shortcut() call.
send_shortcut() {
    hyprctl dispatch "hl.dsp.send_shortcut({ mods = \"$1\", key = \"$2\" })" >/dev/null
}

class="$(active_class)"
if has_native_bindings "$class"; then
    native=yes
else
    native=no
fi

case "$action" in
    end-of-line)
        if [ "$native" = yes ]; then send_shortcut CTRL E; else send_shortcut "" End; fi
        ;;
    beginning-of-line)
        if [ "$native" = yes ]; then send_shortcut CTRL A; else send_shortcut "" Home; fi
        ;;
    kill-line)
        if [ "$native" = yes ]; then
            send_shortcut CTRL K
        else
            send_shortcut SHIFT End
            send_shortcut "" Delete
        fi
        ;;
    backward-word)
        if [ "$native" = yes ]; then send_shortcut ALT B; else send_shortcut CTRL Left; fi
        ;;
    forward-word)
        if [ "$native" = yes ]; then send_shortcut ALT F; else send_shortcut CTRL Right; fi
        ;;
    backward-kill-word)
        if [ "$native" = yes ]; then send_shortcut CTRL W; else send_shortcut CTRL BackSpace; fi
        ;;
esac
