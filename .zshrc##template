# Simple prompt for tramp compatibility
if [[ "$TERM" == "dumb" ]]; then
    unsetopt zle
    PS1="$ "
    return
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git)
if [ -r "$ZSH/oh-my-zsh.sh" ]; then
    source "$ZSH/oh-my-zsh.sh"
fi

# pyenv
{% if yadm.os == "Darwin" %}
if command -v pyenv >/dev/null 2>&1; then
    eval "$(pyenv init -)"
    command -v pyenv-virtualenv-init >/dev/null 2>&1 && eval "$(pyenv virtualenv-init -)"
fi
{% else %}
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
if command -v pyenv >/dev/null 2>&1; then
    eval "$(pyenv init -)"
    command -v pyenv-virtualenv-init >/dev/null 2>&1 && eval "$(pyenv virtualenv-init -)"
fi
{% endif %}

# Google Cloud SDK
{% if yadm.os == "Darwin" %}
if [ -f '/Users/jacobhakansson/Downloads/google-cloud-sdk/path.zsh.inc' ]; then . '/Users/jacobhakansson/Downloads/google-cloud-sdk/path.zsh.inc'; fi
if [ -f '/Users/jacobhakansson/Downloads/google-cloud-sdk/completion.zsh.inc' ]; then . '/Users/jacobhakansson/Downloads/google-cloud-sdk/completion.zsh.inc'; fi
{% else %}
if [ -f "$HOME/google-cloud-sdk/path.zsh.inc" ]; then . "$HOME/google-cloud-sdk/path.zsh.inc"; fi
if [ -f "$HOME/google-cloud-sdk/completion.zsh.inc" ]; then . "$HOME/google-cloud-sdk/completion.zsh.inc"; fi
{% endif %}

# uv / pipx
export PATH="$PATH:$HOME/.local/bin"

# poetry
export PATH="$PATH:$HOME/.poetry/bin"

# direnv
if command -v direnv >/dev/null 2>&1; then
    eval "$(direnv hook zsh)"
fi

# fzf
{% if yadm.os == "Darwin" %}
if command -v fzf >/dev/null 2>&1; then
    source <(fzf --zsh)
fi
{% else %}
[ -r /usr/share/doc/fzf/examples/key-bindings.zsh ] && source /usr/share/doc/fzf/examples/key-bindings.zsh
[ -r /usr/share/doc/fzf/examples/completion.zsh ] && source /usr/share/doc/fzf/examples/completion.zsh
{% endif %}

# SSH agent (systemd-managed, fixed socket path)
{% if yadm.os == "Darwin" %}
{% else %}
if [ -z "${XDG_RUNTIME_DIR:-}" ] && [ -d "/run/user/$(id -u)" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/ssh-agent.socket"
if [ -S "$SSH_AUTH_SOCK" ]; then
    if [ -f ~/.ssh/id_ed25519_github ]; then
        SSH_KEY="$HOME/.ssh/id_ed25519_github"
    elif [ -f ~/.ssh/id_ed25519 ]; then
        SSH_KEY="$HOME/.ssh/id_ed25519"
    else
        SSH_KEY=""
    fi
fi
if [ -n "${SSH_KEY:-}" ]; then
    ssh-add -l >/dev/null 2>&1
    if [ $? -eq 1 ] || ! ssh-add -l 2>/dev/null | grep -Fq "$(ssh-keygen -lf "$SSH_KEY.pub" 2>/dev/null | awk '{print $2}')"; then
        ssh-add "$SSH_KEY" 2>/dev/null
    fi
fi
{% endif %}

# Pass SSH_TTY to tmux so clipetty/OSC 52 clipboard works over SSH
if [ -n "$TMUX" ] && [ -n "$SSH_TTY" ]; then
    tmux set-environment SSH_TTY "$SSH_TTY"
fi

alias tp='tmux-picker'
alias prepare-reboot='save-claude-sessions.sh && tmux run-shell ~/.tmux/plugins/tmux-resurrect/scripts/save.sh && echo "✓ Ready to reboot"'
unalias e 2>/dev/null

# Use the private Claude account under ~/code/private or the "private" tmux
# session; work (~/.claude, the default) everywhere else. See claude-resolve-account.
claude() {
    if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
        command claude "$@"
        return
    fi
    local account_dir
    account_dir=$(claude-resolve-account)
    if [ -n "$account_dir" ]; then
        CLAUDE_CONFIG_DIR="$account_dir" command claude "$@"
    else
        command claude "$@"
    fi
}

# Select the private OMP profile under ~/code/private or in the "private"
# tmux session; otherwise use the unprofiled work configuration.
omp() {
    local profile
    profile=$(omp-resolve-profile)
    if [ -n "$profile" ]; then
        env -u PI_PROFILE -u PI_CODING_AGENT_DIR OMP_PROFILE="$profile" omp "$@"
    else
        env -u OMP_PROFILE -u PI_PROFILE -u PI_CODING_AGENT_DIR omp "$@"
    fi
}

e() {
    if [[ "$OSTYPE" == darwin* ]] && [ -z "${SSH_CONNECTION:-}" ]; then
        emacsclient -n -c "$@"
    elif [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
        emacsclient -n -c "$@"
    else
        emacsclient -t "$@"
    fi
}

# Source local secrets/overrides (not tracked by yadm)
[ -f ~/.zshrc.local ] && source ~/.zshrc.local

# opencode
export PATH="$HOME/.opencode/bin:$PATH"

export EDITOR='emacs'
{% if yadm.os == "Darwin" %}
export EDITOR='emacsclient'
export PATH='$HOME/.duckdb/cli/latest':$PATH
{% endif %}
