-- Keep only your personal keybinding overrides here. Add new bindings or
-- unbind defaults before replacing them.

-- See current bindings and descriptions:
--   omarchy menu keybindings --print

-- To disable every Omarchy default binding, set this in
-- ~/.config/hypr/hyprland.lua before require("default.hypr.omarchy"), then add
-- only the bindings you want below:
--   omarchy_default_bindings = false

-- To disable all preinstalled app/webapp bindings, set:
--   omarchy_preinstalled_bindings = false

-- Add a new binding.
-- o.bind("SUPER + SHIFT + R", "SSH", "alacritty -e ssh your-server")

-- Change an existing binding by unbinding it first, then binding the key again.
-- This example changes SUPER+SPACE from the launcher to the Omarchy root menu.
-- hl.unbind("SUPER + SPACE")
-- o.bind("SUPER + SPACE", "Omarchy menu", "omarchy-menu toggle root")

-- Disable a default binding without replacing it.
-- hl.unbind("SUPER + SHIFT + B")

-- Logitech MX Keys examples:
-- o.bind("SUPER + SHIFT + S", nil, "omarchy-capture-screenshot")
-- o.bind("SUPER + H", nil, "voxtype record toggle")
-- o.bind("SUPER + PERIOD", nil, "omarchy-shell shell toggle omarchy.emojis")

-- BEGIN dotfiles macOS-style browser shortcuts
-- Remap SUPER+W/T/L and bracket/brace tab-switching to macOS-style browser
-- shortcuts; falls back to WM actions in non-browser windows. See
-- omarchy-macos-browser-shortcut.
hl.unbind("SUPER + W")
hl.unbind("SUPER + T")
hl.unbind("SUPER + L")
hl.unbind("SUPER + SHIFT + bracketleft")
hl.unbind("SUPER + SHIFT + bracketright")
hl.unbind("SUPER + braceleft")
hl.unbind("SUPER + braceright")
o.bind("SUPER + W", "Close tab/window", "omarchy-macos-browser-shortcut close")
o.bind("SUPER + T", "New tab/toggle floating", "omarchy-macos-browser-shortcut new-tab")
o.bind("SUPER + L", "Focus location/layout", "omarchy-macos-browser-shortcut focus-location")
o.bind("SUPER + SHIFT + bracketleft", "Previous browser tab", "omarchy-macos-browser-shortcut previous-tab")
o.bind("SUPER + SHIFT + bracketright", "Next browser tab", "omarchy-macos-browser-shortcut next-tab")
o.bind("SUPER + braceleft", "Previous browser tab", "omarchy-macos-browser-shortcut previous-tab")
o.bind("SUPER + braceright", "Next browser tab", "omarchy-macos-browser-shortcut next-tab")
-- END dotfiles macOS-style browser shortcuts

-- BEGIN dotfiles T2 laptop brightness fix
-- Stock omarchy-brightness-display picks the wrong backlight device on this
-- machine (Touch Bar instead of the screen) - see omarchy-brightness-display-t2.
hl.unbind("XF86MonBrightnessUp")
hl.unbind("XF86MonBrightnessDown")
hl.unbind("SHIFT + XF86MonBrightnessUp")
hl.unbind("SHIFT + XF86MonBrightnessDown")
hl.unbind("ALT + XF86MonBrightnessUp")
hl.unbind("ALT + XF86MonBrightnessDown")
o.bind("XF86MonBrightnessUp", "Brightness up", "omarchy-brightness-display-t2 +5%")
o.bind("XF86MonBrightnessDown", "Brightness down", "omarchy-brightness-display-t2 5%-")
o.bind("SHIFT + XF86MonBrightnessUp", "Brightness maximum", "omarchy-brightness-display-t2 100%")
o.bind("SHIFT + XF86MonBrightnessDown", "Brightness minimum", "omarchy-brightness-display-t2 1%")
o.bind("ALT + XF86MonBrightnessUp", "Brightness up precise", "omarchy-brightness-display-t2 +1%")
o.bind("ALT + XF86MonBrightnessDown", "Brightness down precise", "omarchy-brightness-display-t2 1%-")
-- END dotfiles T2 laptop brightness fix

-- BEGIN dotfiles tab-navigation swap
-- SUPER+Tab cycles windows; ALT+Tab switches workspaces (swapped from
-- Omarchy's defaults).
hl.unbind("SUPER + TAB")
hl.unbind("SUPER + SHIFT + TAB")
hl.unbind("ALT + TAB")
hl.unbind("ALT + SHIFT + TAB")
o.bind("SUPER + TAB", "Focus on next window", hl.dsp.window.cycle_next())
o.bind("SUPER + SHIFT + TAB", "Focus on previous window", hl.dsp.window.cycle_next({ next = false }))
o.bind("SUPER + TAB", "Reveal active window on top", hl.dsp.window.bring_to_top())
o.bind("SUPER + SHIFT + TAB", "Reveal active window on top", hl.dsp.window.bring_to_top())
o.bind("ALT + TAB", "Next workspace", hl.dsp.focus({ workspace = "e+1" }))
o.bind("ALT + SHIFT + TAB", "Previous workspace", hl.dsp.focus({ workspace = "e-1" }))
-- END dotfiles tab-navigation swap

-- BEGIN dotfiles macOS-style emacs text navigation
-- Terminals/Emacs already support these natively; elsewhere they're
-- translated to the non-emacs equivalent (End/Home/word-delete etc) - see
-- omarchy-emacs-nav-shortcut. Note: this takes over Ctrl+W everywhere,
-- including browsers, where it now deletes a word instead of closing the tab
-- (use SUPER+W for that).
o.bind("CTRL + E", "End of line", "omarchy-emacs-nav-shortcut end-of-line")
o.bind("CTRL + A", "Beginning of line", "omarchy-emacs-nav-shortcut beginning-of-line")
o.bind("CTRL + K", "Kill to end of line", "omarchy-emacs-nav-shortcut kill-line")
o.bind("ALT + B", "Word back", "omarchy-emacs-nav-shortcut backward-word")
o.bind("ALT + F", "Word forward", "omarchy-emacs-nav-shortcut forward-word")
o.bind("CTRL + W", "Delete word back", "omarchy-emacs-nav-shortcut backward-kill-word")
-- END dotfiles macOS-style emacs text navigation
